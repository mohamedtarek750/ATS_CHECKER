# Reading CVs. `offline` is rules-only: no key, no quota, ~100 ms per CV, and
# the only option that copes with a thousand applicants.
ATS_PROVIDER=offline

# Reading a job advert always needs a model - turning prose into must-have and
# nice-to-have is the one judgement rules cannot make.
GEMINI_API_KEY=

# --- where applications are kept ------------------------------------------
# local  : files under data/hiring. The default. No accounts, nothing leaves
#          the machine, and it is what the tests run against.
# sheets : a Google Sheet a recruiter can open, with the CVs in Drive.
ATS_BACKEND=local

# Only for ATS_BACKEND=sheets. Share BOTH the sheet and the Drive folder with
# the service account's client_email, or it cannot see them.
ATS_SHEET_ID=
ATS_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- who can open the dashboard -------------------------------------------
# Required by default, and it fails CLOSED: with these unset the dashboard
# refuses to open rather than standing wide. It holds applicants' CVs.
#
# Make an OAuth client id at console.cloud.google.com > APIs & Services >
# Credentials > OAuth client ID > Web application, and add your site to the
# authorised JavaScript origins.
GOOGLE_OAUTH_CLIENT_ID=
ATS_ADMIN_EMAILS=

# Development only. Opens the dashboard with no sign-in, and says so on screen
# the whole time. Never set this on a deployment holding real applications.
# ATS_AUTH=off

# --- email (optional) -----------------------------------------------------
# With these unset nothing is sent and nothing breaks: an applicant still gets
# their receipt on screen, and the dashboard still works.
#
# Two messages only: a receipt to the person who applied, and a digest to the
# hiring team when new applications have been read. A rejection is never
# emailed automatically - a percentage from a document parser is not grounds
# for a machine to tell somebody they did not get the job.
RESEND_API_KEY=
ATS_MAIL_FROM=
ATS_HR_EMAILS=

# The scheduled read (hourly, see vercel.json). Vercel sends this as a bearer
# token; with it unset the endpoint refuses rather than standing open.
CRON_SECRET=

# --- the prototype path: a sheet, with no credentials at all ---------------
# An Apps Script deployed FROM the spreadsheet runs as its owner, so there is
# nothing to authenticate: no cloud project, no service account, no API key.
# Paste scripts/ats_sheet_backend.gs into Extensions > Apps Script, then
# Deploy > New deployment > Web app (Execute as: Me, Who has access: Anyone).
# The URL it returns ends in /exec.
#
# The URL is an open endpoint - whoever holds it can read and write the sheet.
# Fine for a prototype with test data. Before real applicants, set SHARED_KEY
# in the script and the same value in ATS_SCRIPT_KEY, or move to
# ATS_BACKEND=sheets.
# ATS_BACKEND=script
# ATS_SCRIPT_URL=
# ATS_SCRIPT_KEY=
