# Copy this file to .env and fill in the key for the provider you use.

# --- Which backend ---
# gemini = Google, has a free tier    |    claude = Anthropic, paid
ATS_PROVIDER=gemini

# --- Gemini (free): get a key at aistudio.google.com/apikey ---
GEMINI_API_KEY=

# --- Claude (paid): get a key at console.anthropic.com ---
# ANTHROPIC_API_KEY=

# --- Optional overrides ---
# ATS_MODEL=gemini-2.5-flash      # blank = the provider's default
# ATS_GEMINI_RPM=10               # free-tier requests per minute
# ATS_AI_THRESHOLD=70
# ATS_MIN_ROLE_CONFIDENCE=40
# ATS_MIN_CHARS=250
# ATS_INBOX=data/inbox
# ATS_OUTPUT=data/output
# ATS_FILE_ACTION=copy
# ATS_MAX_WORKERS=                # blank = per-provider default
